# Release signing configuration.
#
# 1. Generate an upload keystore OUTSIDE this repository (see
#    docs/android-deployment.md for the keytool command).
# 2. Copy this file to android/keystore.properties and fill in real values.
# 3. NEVER commit keystore.properties or any .jks/.keystore file.
#
# storeFile is resolved relative to the android/ directory; an absolute path
# outside the repository is strongly recommended.
storeFile=/absolute/path/to/android-upload.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=sleep-tracker-upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
